# ==========================================================
#  PharmaBridge B2B — root .gitignore
# ==========================================================

# ----- Dependencies -----
node_modules/
backend/node_modules/
frontend/node_modules/

# ----- Environment / secrets (NEVER commit) -----
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
backend/.env
frontend/.env
# (.env.example files ARE committed — dummy values only)

# ----- Build output -----
dist/
build/
dist-ssr/
frontend/dist/
backend/dist/

# ----- Logs -----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Generated / temp -----
graphify-out/
*.local
*.tmp
.cache/

# ----- Local agent / skill tooling (not part of the product) -----
.claude/
.agents/
.codex/
.impeccable/
skills-lock.json

# ----- Editor / OS -----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
